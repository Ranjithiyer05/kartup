# Copy to .env for local development. Never commit .env.

# Long random string used to sign admin session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Leave unset locally to use SQLite (instance/kartup.db).
# In production, set to your PostgreSQL connection string.
# DATABASE_URL=postgresql://user:password@host:5432/kartup

# Admin login for /admin
ADMIN_USERNAME=admin
# Preferred: a password hash. Generate with: flask --app wsgi hash-password
ADMIN_PASSWORD_HASH=
# Alternative for quick local testing only (ignored if ADMIN_PASSWORD_HASH is set):
# ADMIN_PASSWORD=
